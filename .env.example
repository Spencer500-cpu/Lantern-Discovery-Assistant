# Copy this file to .env and add your OpenAI API key.
AI_API_KEY=replace_with_your_api_key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional local web-server port
PORT=8000

# Keep this disabled for the personal local-only setup.
# For a hosted shared workspace, use TEAM_MODE=1, set a unique 14+ character
# admin password, set HOST=0.0.0.0, and require HTTPS at the hosting proxy.
TEAM_MODE=0
ADMIN_USERNAME=lantern-admin
ADMIN_PASSWORD=
COOKIE_SECURE=0
HOST=127.0.0.1
OPEN_BROWSER=1
# Optional persistent data folder (set to a mounted disk path when hosted)
# DATA_DIR=
